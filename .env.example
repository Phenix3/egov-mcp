# LLM provider (anthropic | openai | k2think)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Clés API — remplir selon le provider choisi
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
K2_API_KEY=
K2_BASE_URL=https://api.k2think.ai/v1

# Auth MCP (laisser vide pour dev local, obligatoire en production)
MCP_AUTH_TOKEN=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
