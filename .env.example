# LLM provider (anthropic | openai | k2think | openai_compat | mistral | openrouter)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Clés API — remplir selon le provider choisi
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
K2_API_KEY=
K2_BASE_URL=https://api.k2think.ai/v1

# Provider OpenAI-compatible générique
# Mistral    : OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1      LLM_MODEL=mistral-small-latest
# OpenRouter : OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=mistralai/mistral-7b-instruct
# Ollama     : OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3
# LM Studio  : OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1        LLM_MODEL=local-model
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# Auth MCP (laisser vide pour dev local, obligatoire en production)
MCP_AUTH_TOKEN=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
